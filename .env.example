# Copy this file to .env and fill in real values. Never commit .env itself.

# Used by the "Dokąd chcesz polecieć?" free-text destination search — a
# local Ollama model interprets the query (country/region names, weather
# preferences) against the curated airport list. No cost, no API key.
# Install: `brew install ollama && brew services start ollama && ollama pull
# llama3.1:8b`. Without Ollama running, destination search only works for an
# empty query ("anywhere").
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Telegram bot used to send alerts (create one via @BotFather; get your
# chat id by messaging the bot then hitting api.telegram.org/bot<token>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Postgres connection. Defaults below match docker-compose.yml's db service;
# override DB_HOST=db when running the scraper itself inside Docker.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flights
DB_USER=user
DB_PASSWORD=password

# Port the web UI listens on (default 5000)
PORT=5000

# How many Google Flights pages to scrape concurrently per search (default 5).
# Higher = faster searches, but also more concurrent load on Google's side —
# raise cautiously.
SCRAPE_CONCURRENCY=5

# How many minutes a scraped leg is considered "fresh" before a search will
# scrape it again instead of reusing what's in Postgres (default 30). 0
# disables the cache and always scrapes live.
CACHE_MAX_AGE_MINUTES=30
